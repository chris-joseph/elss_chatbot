# Groww Mutual Fund FAQ Assistant - Environment Configuration

# Optional: DeepSeek API Key for LLM-powered answer generation.
# If left blank, the assistant automatically falls back to the deterministic facts-only grounded extractor.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM Base URL (Default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM Model Name (Default: deepseek-chat)
LLM_MODEL=deepseek-chat

# Streamlit Server Port (Default: 8501)
PORT=8501
