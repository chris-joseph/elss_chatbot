# Groww Mutual Fund FAQ Assistant - Environment Configuration

# Provider: 'auto', 'groq', 'deepseek', 'openai', 'ollama', or 'custom'
# If left as 'auto', the assistant automatically detects your key and connects.
# If no key is provided, it falls back to the deterministic facts-only grounded extractor.
LLM_PROVIDER=auto

# Recommended / Fastest: Groq API Key (Free tier at https://console.groq.com)
# Provides ultra-fast 300-500 tokens/sec inference on Llama 3.3 70B & 3.1 8B.
GROQ_API_KEY=your_groq_api_key_here

# Optional: DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Optional: OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=

# Optional: Custom or Local Base URL (e.g., http://localhost:11434/v1 for Ollama)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Model Name (Default for Groq: llama-3.3-70b-versatile, DeepSeek: deepseek-chat, OpenAI: gpt-4o-mini)
LLM_MODEL=llama-3.3-70b-versatile

# Streamlit Server Port (Default: 8501)
PORT=8501
